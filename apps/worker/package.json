    "fluent-ffmpeg": "^2.1.3",
    "got": "^15.0.3",
    "got-scraping": "^4.2.1",
    "json5": "^2.2.3",
    "p-limit": "^5.0.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.0",
    "playwright": "^1.47.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-core": "^24.42.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
