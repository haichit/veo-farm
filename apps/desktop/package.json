{
  "name": "@veo-farm/desktop",
  "version": "0.1.8",
  "private": true,
  "description": "Veo Farm — Electron desktop shell",
  "main": "dist/main.js",
  "scripts": {
    "build:tsc": "tsc -p tsconfig.json",
    "build:shared": "pnpm --filter @veo-farm/shared build",
    "build:web": "pnpm --filter @veo-farm/web build && node scripts/copy-web-static.cjs",
    "build:worker": "pnpm --filter @veo-farm/worker build",
    "build": "pnpm build:tsc && pnpm build:shared && pnpm build:web && pnpm build:worker",
    "start": "electron .",
    "dist": "pnpm build && electron-builder --win --x64",
    "dist:dir": "pnpm build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "electron-log": "^5.1.0",
    "electron-updater": "^6.2.0",
    "7zip-bin": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "31.7.7",
    "electron-builder": "^24.13.0",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.veofarm.app",
    "productName": "Veo Farm",
    "electronVersion": "31.7.7",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/.next/standalone",
        "to": "web",
        "filter": ["**/*"]
      },
      {
        "from": "../web/.next/static",
        "to": "web/apps/web/.next/static",
        "filter": ["**/*"]
      },
      {
        "from": "../web/public",
        "to": "web/apps/web/public",
        "filter": ["**/*"]
      },
      {
        "from": "../worker/dist",
        "to": "worker",
        "filter": ["**/*"]
      },
      {
        "from": "../worker/package.json",
        "to": "worker/package.json"
      },
      {
        "from": "../../packages/shared/dist",
        "to": "shared",
        "filter": ["**/*"]
      },
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Veo Farm"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "haichit",
        "repo": "veo-farm",
        "releaseType": "release"
      }
    ]
  }
}
